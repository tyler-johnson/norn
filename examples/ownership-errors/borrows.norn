// Where `&` gets a teaching answer instead of a meaning (BOOTSTRAP §8 item 5). References are
// not part of Norn: reads are unmarked and take nothing, a parameter that consumes declares
// `sink`, and a parameter that is written back declares `mut`. Each declaration here is wrong in
// exactly one way, and each answer names the spelling that replaced the borrow.

// A struct field owns; `&` does not name a type.
struct Held {
    conn: &Connection
}

// A parameter spelled `&T`: parameters read by default, so the mark said nothing `T` does not.
fn peek(conn: &Connection) -> () {
    ()
}

// A return type: the caller is handed the value itself.
fn hand_back(conn: Connection) -> &Connection {
    conn
}

// `&mut`: mutation is declared in the signature — `mut T` — and call sites stay unmarked.
fn rewrite(conn: &mut Connection) -> () {
    ()
}

// A borrowed expression: there is nothing for `&` to take — reading does not consume.
task fn names_a_borrow() -> () {
    match await tcp_listen(0) {
        Ok(listener) => {
            let held = &listener
            print(listener_port(held))
        }
        Err(_) => ()
    }
}

// An argument spelled `&x`: whether a call consumes is its signature's fact, never the site's.
task fn reads_with_a_mark(conn: Connection) -> () {
    match await tcp_read(&conn) {
        Ok(_) => ()
        Err(_) => ()
    }
}
