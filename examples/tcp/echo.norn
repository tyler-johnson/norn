// A TCP echo server, which is what M2 is asked to run.
//
// `main` binds a listener on a port the operating system chooses, prints it so a client can find
// it, and starts an accept loop inside a scope. When the scope closes — here on a timer, in a real
// service on a shutdown signal — the accept loop is cancelled, that cancellation cascades to every
// connection it is serving, and every socket is closed on the way out. No cleanup is written
// anywhere in this file.
//
// The accept loop is a `loop` inside a `scope`: the scope owns every child the loop spawns, each
// pass borrows the listener and hands its connection to a fresh child, and when accepting fails —
// cancellation closes the listener — the loop breaks and the scope joins what it started.

import { digits } from "std/fmt"

task fn echo(conn: Connection) -> ()
    uses { net.io }
{
    match await tcp_read(&conn) {
        Ok(text) => match await tcp_write(&conn, text) {
            Ok(_) => ()
            Err(_) => ()
        }
        Err(_) => ()
    }
    await tcp_close(conn)
}

task fn accept_loop(listener: Listener) -> ()
    uses { net.io }
{
    scope {
        loop {
            match await tcp_accept(&listener) {
                // The connection moves into the child, which is then what owns and closes it. The
                // scope wrapping the loop is what that child may not outlive.
                Ok(conn) => spawn echo(conn)
                Err(_) => break
            }
        }
    }
}

task fn main() -> Result<(), IoError>
    uses { clock, net.listen, net.io }
{
    let listener = await tcp_listen(0)?
    print(digits(listener_port(&listener)))
    scope {
        spawn accept_loop(listener)
        await sleep(200)
    }
    Ok(())
}
