// Method resolution: what the receiver's type refuses. One file, because every case is the
// same resolver answering a different receiver.

trait Loud {
    fn shout(value: Self) -> String
}

trait Quiet {
    fn shout(value: Self) -> String
}

impl Loud for I64 {
    fn shout(value: Self) -> String {
        "LOUD"
    }
}

impl Quiet for I64 {
    fn shout(value: Self) -> String {
        "quiet"
    }
}

enum Shape {
    Empty
    Dot(I64)
}

struct User {
    name: String
}

// A bare parameter has no methods until a bound gives it some.
fn describe<T>(value: T) -> String {
    value.to_string()
}

fn main() {
    // A local shadows an enum head in call position, exactly as it does in value position:
    // this is a method lookup on I64, not a variant construction.
    let Shape = 1
    let a = Shape.Empty()
    // No impl anywhere provides `frobnicate`.
    let b = 7.frobnicate()
    // A field is a value, not a method.
    let user = User(name: "ada")
    let c = user.name()
    // Two traits provide `shout` for I64, and a method call cannot say which.
    let d = 3.shout()
}

trait Consume {
    fn consume(value: sink Self) -> String
}

impl Consume for User {
    fn consume(value: sink Self) -> String {
        value.name
    }
}

// A `sink Self` method takes its receiver — asserted at the trait, so it holds however cheap a
// `User` is to copy — and the second call finds the name gone.
fn consumes_twice(user: User) -> String {
    user.consume() + user.consume()
}

reactor Gate(limit: I64) {
    input opened: () [capacity: 4, overflow: reject]

    state accepted: I64 = 0

    on opened() {
        accepted = accepted + 1
    }

    export signal healthy = accepted <= limit
}

trait Close {
    task fn close(handle: sink Self) -> ()
}

impl Close for Gate {
    task fn close(handle: sink Self) -> () {
        await send(handle.opened, ())
    }
}

// A handle's own member surface wins over any impl, however many traits `Gate` has: an input is a
// mailbox and an exported signal is read, so neither is ever a method. The teach is which builtin
// reaches the member, because that is the thing the writer meant.
task fn drive(gate: Gate) -> () {
    let a = gate.opened()
    let b = gate.healthy()
    // `close` declares `sink Self`, so the handle's name dies at the call. A handle is copyable and
    // the assertion holds anyway — revoking the name is what writing `sink` means.
    await gate.close()
    await gate.close()
}
