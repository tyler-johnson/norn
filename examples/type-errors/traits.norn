// Traits and bounds: what conformance, coherence, and the instantiation gate refuse. The
// resolver's refusals live in methods.norn; these are the declaration-side rules.

trait Display {
    fn to_string(value: Self) -> String
}

trait Label {
    fn label(value: Self) -> String
}

struct Post {
    id: I64
}

// The gate's flagship: `Post` does not satisfy the bound the call needs.
fn contains<T: Eq>(items: T, wanted: T) -> Bool {
    items == wanted
}

// Bounds live on functions alone: a type holds anything, operations need capabilities.
struct Wrapper<T: Eq> {
    value: T
}

// A bound names a trait, and no trait by this name exists.
fn show<T: Prettify>(value: T) -> String {
    "?"
}

// The declared bounds do not provide the method that was called.
fn speak<T: Display>(value: T) -> String {
    value.label()
}

// The seeded marker cannot be implemented by hand.
impl Eq for Post {}

impl Display for Post {
    fn to_string(value: Self) -> String {
        "post"
    }
}

// One impl per trait and type, program-wide.
impl Display for Post {
    fn to_string(value: Self) -> String {
        "again"
    }
}

// An impl provides all of the trait or none of it.
impl Label for Post {}

fn main() {
    let a = contains(Post(id: 1), Post(id: 1))
}

// A trait member declares no capabilities. The clause parses — the grammar is permissive about
// member shapes — and is refused here permanently: what a method reaches is a fact about the impl
// that runs, and the trait can see none of those bodies.
trait Ping {
    task fn ping(value: Self) -> ()
        uses { clock }
}

// Whether a call builds a task is part of the contract, so the impl spells the same word. Both
// directions are wrong in the same way.
trait Wake {
    task fn wake(value: Self) -> ()
}

trait Rest {
    fn rest(value: Self) -> ()
}

impl Wake for Post {
    fn wake(value: Self) -> () {
        print("awake")
    }
}

impl Rest for Post {
    task fn rest(value: Self) -> () {
        print("resting")
    }
}

// An impl function declares no capabilities either, for the same reason from the other side.
trait Nap {
    task fn nap(value: Self) -> ()
}

impl Nap for Post {
    task fn nap(value: Self) -> ()
        uses { clock }
    {
        await sleep(1)
    }
}

reactor Meter(limit: I64) {
    input tick: () [capacity: 4, overflow: reject]

    state count: I64 = 0

    on tick() {
        count = count + 1
    }

    export signal level = count
}

// A handle's member surface is fixed before its methods are: `meter.tick` and `meter.tick()` would
// name two unrelated things, so a method may not shadow an input or an exported signal.
trait Shadow {
    fn tick(value: Self) -> I64
    fn level(value: Self) -> I64
}

impl Shadow for Meter {
    fn tick(value: Self) -> I64 {
        0
    }

    fn level(value: Self) -> I64 {
        1
    }
}
