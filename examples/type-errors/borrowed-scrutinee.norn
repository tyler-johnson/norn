// A `match` through `&` binds copies, so a borrowed scrutinee may not reach a resource: a
// descriptor has one owner, and a binding here would quietly be a second. Each function is wrong
// in exactly one way; the owned spellings — `match session`, `match maybe` — stay legal, because
// taking an aggregate apart is what a match on the owned value means.

struct Session {
    conn: Connection
    opened: I64
}

// The struct case: the resource is one field away.
fn inspect(session: &Session) -> I64 {
    match session {
        Session(conn: _, opened: opened) => opened
    }
}

// The recursive case: the resource sits behind a constructor, and the test has to reach it.
fn peek(maybe: &Option<Connection>) -> Bool {
    match maybe {
        Some(_) => true
        None => false
    }
}
