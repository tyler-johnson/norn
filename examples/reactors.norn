// The reactor grammar, as syntax. Nothing here is checked or run — this file is the M0 corpus's
// regression net for the new productions, the way `tasks.norn` is for tasks, so it deliberately
// includes forms later milestones will bring meaning to.

struct Snapshot {
    open: I64
    healthy: Bool
}

export reactor Gate(limit: I64) {
    input opened: () [capacity: 64, overflow: reject]
    input closed: () [capacity: 8, overflow: drop_oldest]
    input measured: Sample [capacity: 1, overflow: drop_newest]
    input queued: Job [capacity: 128, overflow: wait]

    state accepted: I64 = 0
    state released: I64 = 0

    on opened() {
        accepted = accepted + 1
    }

    on closed() {
        released = released - 1
    }

    signal open = accepted - released
    signal healthy: Bool = open <= limit

    export signal snapshot = Snapshot(open: open, healthy: healthy)
}

// `uses` on a reactor is the authority its effects need, and the spawner's set must cover it.
reactor Mailbox(retries: I64)
    uses { clock, net.io }
{
    input send: OutgoingMessage [capacity: 256, overflow: wait]
    input delivered: DeliveryResult [capacity: 256, overflow: wait]

    state pending: I64 = 0
    state failed: I64 = 0

    on send(message) {
        pending = pending + 1
        after deliver(message) -> delivered
    }

    on delivered(result) {
        pending = pending - 1
        match result {
            DeliveryResult.Ok => ()
            DeliveryResult.Failed(_) => {
                failed = failed + 1
            }
        }
    }

    export signal depth = pending
    export signal report = Report(pending: pending, failed: failed, retries: retries)
}

// The merged spelling: an `on` that carries a queue clause declares the input it responds to. The
// parameter's type is the message type — written where the message is bound rather than one member
// away — and `on opened()` with a clause declares an input carrying `()`.
reactor Meter(window: I64) {
    on sampled(value: F64) [capacity: 32, overflow: drop_oldest] {
        total = total + value
        seen = seen + 1
    }

    on reset() [capacity: 1, overflow: reject] {
        total = 0.0
        seen = 0
    }

    // Both spellings are legal in one reactor: this input is declared here and answered below.
    input trimmed: Trim [capacity: 4, overflow: wait]

    state total: F64 = 0.0
    state seen: I64 = 0

    on trimmed(bound) {
        seen = seen - bound.count
    }

    export signal mean = total / window
}

task fn drive(limit: I64) -> ()
    uses { clock }
{
    scope {
        let gate = spawn reactor Gate(limit: limit)
        await send(gate.opened, ())
        print(latest(gate.snapshot))
    }
}
