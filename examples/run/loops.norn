// Loops: `while` and `loop`, `break` and `continue`.
//
// A `while` produces (); a `loop` produces what its `break value`s agree on. The parts worth
// exercising are the ones that cross a boundary: an `await` in the body parks and resumes across
// the back edge, and a `break` from inside a `scope { }` leaves the scope before it leaves the
// loop — the same unwinding a `return` does.

task fn main()
    uses { clock }
{
    // A countdown: the condition re-evaluates before every pass.
    let mut n = 3
    while n > 0 {
        print(n)
        n = n - 1
    }

    // A `loop` is an expression, valued by its `break`.
    let mut k = 1
    let total = loop {
        k = k * 2
        if k > 20 {
            break k
        }
    }
    print(total)

    // `continue` skips to the next pass.
    let mut i = 0
    let mut odds = 0
    while i < 10 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        odds = odds + 1
    }
    print(odds)

    // `break` as a match-arm body: the accept-loop shape.
    let mut left = 3
    let drained = loop {
        match step(left) {
            Some(next) => { left = next }
            None => break "drained"
        }
    }
    print(drained)

    // An `await` inside the body: the task parks and resumes mid-iteration, every iteration.
    let mut sum = 0
    let mut j = 0
    while j < 3 {
        sum = sum + await double(j)
        j = j + 1
    }
    print(sum)

    // A nested loop: the inner `continue` targets the inner loop, the inner `break` leaves it.
    let mut row = 0
    let mut cells = 0
    while row < 3 {
        row = row + 1
        let mut col = 0
        loop {
            col = col + 1
            if col == 2 {
                continue
            }
            if col > 3 {
                break
            }
            cells = cells + 1
        }
    }
    print(cells)

    // A `break` from inside a `scope { }` leaves the scope first — the same unwinding a `return`
    // does — so each pass's child has finished by the time the next pass starts.
    let mut passes = 0
    loop {
        scope {
            spawn shout(passes)
            await sleep(1)
            passes = passes + 1
            if passes == 2 {
                break
            }
        }
    }
    print(passes)
}

fn step(n: I64) -> Option<I64> {
    if n > 0 { Some(n - 1) } else { None }
}

task fn double(n: I64) -> I64 {
    n + n
}

task fn shout(n: I64) {
    print(n)
}
