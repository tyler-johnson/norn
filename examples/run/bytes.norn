// Bytes: the value the wire carries and a file holds.
//
// There is no bytes literal — data arrives from I/O, from `bytes(s)`, which is a string's UTF-8,
// or is built up from `byte(n)` joined with `+`.
// A slice copies in v0 (the clone-everything engines cannot make zero-copy observable), decoding
// back to text is fallible because not every octet sequence is UTF-8 — and that decoding is
// `std/bytes`'s `to_string`, the first builtin dissolved into std: the validator is ordinary
// Norn over `data[i]`, with only the trusting `text_unchecked` beneath it. Printing a bytes
// value shows its length rather than inventing an escape syntax for its contents.

import { to_string } from "std/bytes"

fn main() -> () {
    let data = bytes("hello, norn")
    print(data)
    print(bytes_len(data))

    let head = bytes_slice(data, 0, 5)
    match to_string(head) {
        Some(text) => print(text)
        None => print("not text")
    }

    // Slicing through the middle of a multi-byte character is not text any more.
    let snowman = bytes("☃")
    match to_string(bytes_slice(snowman, 0, 1)) {
        Some(text) => print(text)
        None => print("a torn character is not text")
    }

    // Well-formedness is more than complete sequences: an overlong spelling of NUL and half a
    // surrogate pair are the subtle refusals, the shapes a length check alone would miss.
    match to_string(byte(192) + byte(128)) {
        Some(text) => print(text)
        None => print("an overlong encoding is not text")
    }
    match to_string(byte(237) + byte(160) + byte(128)) {
        Some(text) => print(text)
        None => print("a surrogate half is not text")
    }

    // `data[i]` reads one octet as an I64. Out of range traps, like `bytes_slice`.
    print(data[0])
    print(data[bytes_len(data) - 1])

    // An index and a loop together: the sum of every byte.
    let mut sum = 0
    let mut i = 0
    while i < bytes_len(data) {
        sum = sum + data[i]
        i = i + 1
    }
    print(sum)

    // Building: `byte` is one octet — it traps outside 0..255 — and `+` joins two buffers,
    // allocating a fresh one.
    print(byte(110) == bytes("n"))
    match to_string(bytes("hello, ") + bytes("norn")) {
        Some(text) => print(text)
        None => print("not text")
    }
    print(data + bytes("") == data)

    // Equality is by content, and ordering is lexicographic.
    print(bytes_slice(data, 7, 11) == bytes("norn"))
    print(bytes("abc") < bytes("abd"))
    print(bytes("") == bytes_slice(data, 4, 4))
}
