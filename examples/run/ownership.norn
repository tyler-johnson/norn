// Ownership's legal lane (BOOTSTRAP §8 item 5): reads are unmarked. An ordinary value copies —
// using one is never giving it away — and only what reaches a resource moves, so the marks live
// where the semantics do: in signatures, where `sink` is the one word that hands a value over.
// This file is the everyday vocabulary that needs no word at all: field reads copy, passing a
// value reads it, `match x` asks without taking, a `Self` method reads its receiver, and
// assignment writes a name.

import { List, length, join } from "std/list"
import { to_string } from "std/fmt"

struct Account {
    owner: String
    balance: I64
}

enum Weather {
    Clear
    Rain(I64)
}

trait Describe {
    fn describe(value: Self) -> String
}

impl Describe for Account {
    fn describe(value: Self) -> String {
        value.owner + " holds " + to_string(value.balance)
    }
}

// Take a copy, return the successor: `x = deposit(x, n)` writes the new value over the old.
// (Changing a value in place is the `mut` wave's story, declared in the signature like `sink`.)
fn deposit(account: Account, amount: I64) -> Account {
    Account(owner: account.owner, balance: account.balance + amount)
}

fn main() {
    // Field reads copy — reading `owner` twice takes nothing, because the struct stays whole.
    let account = Account(owner: "ada", balance: 10)
    print(account.owner)
    print(account.owner)

    // A method reads its receiver — `Self` is a read like any other parameter — so the name
    // survives the call, and the next one.
    print(account.describe())
    print(account.describe())

    // The revive idiom: the name owns the successor at the bottom of every pass, which is what
    // keeps it legal in a loop.
    let mut running = account
    let mut n = 0
    while n < 3 {
        running = deposit(running, 5)
        n = n + 1
    }
    print(running.balance)

    // `match x` asks which case holds; the bindings are copies, and `sky` is still whole after.
    let sky = Weather.Rain(12)
    match sky {
        Weather.Rain(mm) => print(mm)
        Weather.Clear => print("clear")
    }

    // Printing reads too: twice is two looks at one value.
    print(sky)
    print(sky)

    // Reads are unmarked in std/list as well: one list serves every walk.
    let readings = List.Cons(7, List.Cons(9, List.Nil))
    print(length(readings))
    print(join(readings, ", "))
}
