// An HTTP hello server: the echo server's shape, speaking a real protocol from std.
//
// `read_request` borrows the Connection and parses the head into an ordinary struct — a request
// is plain data now, not a resource, so nothing changes kind and nothing is left to double-take.
// `respond` consumes the Connection: every v0 response says `Connection: close`, so answering
// and closing are one act, and answering twice would be a move error. A malformed head is an
// `Err` naming the broken rule, and the socket stays the scope's to close on the way out — no
// cleanup is written anywhere in this file.
//
// As in the echo server, `main` prints the port the operating system chose so a client can find
// it, and the accept loop is the same `scope { loop { … } }`.

import { to_string } from "std/fmt"
import { read_request, respond } from "std/http"

task fn serve(conn: Connection) -> ()
    uses { net.io }
{
    match await read_request(&conn) {
        Ok(_) => match await respond(conn, 200, "hello from norn\n") {
            Ok(_) => ()
            Err(_) => ()
        }
        // The connection was only borrowed, so it is still owned here; the scope closes it.
        Err(_) => ()
    }
}

task fn accept_loop(listener: Listener) -> ()
    uses { net.io }
{
    scope {
        loop {
            match await tcp_accept(&listener) {
                Ok(conn) => spawn serve(conn)
                Err(_) => break
            }
        }
    }
}

task fn main() -> Result<(), IoError>
    uses { clock, net.listen, net.io }
{
    let listener = await tcp_listen(0)?
    print(to_string(listener_port(&listener)))
    scope {
        spawn accept_loop(listener)
        await sleep(200)
    }
    Ok(())
}
