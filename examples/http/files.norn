// The M6 done-when: an HTTP file server, streaming in both directions — now through std/http.
//
// A PUT streams the request body to disk through `save_body`: the head's leftover bytes land
// first, then the loop holds one `tcp_read` chunk at a time, so a large upload never sits in
// memory. A GET answers with a file as the response body through `respond_flow`, the flow
// intrinsics pointed the other way. Dispatch is a `match` on `req.method`, because v0 has free
// functions and string patterns and does not need more than that.
//
// `?` in `upload` is the error story: if the file cannot be created, the function unwinds, the
// handler's scope closes, and the connection is closed by the scope rather than by code — the
// client sees the connection drop, which is what an unhandled server error is. A malformed head
// gets the same ending: `read_request` returns an `Err` naming the rule, and the socket it only
// borrowed falls to the scope.
//
// The path is prefixed with `.` and guarded: `has_dotdot` walks the path's bytes with `data[i]`,
// and a request that tries `..` traversal is answered 400 before the method is dispatched.

import { to_string } from "std/fmt"
import { read_request, respond, respond_empty, respond_flow, save_body, Request } from "std/http"

task fn upload(conn: Connection, req: Request) -> Result<(), IoError>
    uses { net.io, fs.write }
{
    let sink = await file_create("." + req.path)?
    let saved = await save_body(&conn, req, sink)?
    await respond_empty(conn, 204)
}

task fn download(conn: Connection, req: Request) -> Result<(), IoError>
    uses { net.io, fs.read }
{
    match await flow_of_file("." + req.path) {
        Ok(body) => await respond_flow(conn, 200, body)
        Err(IoError.NotFound) => await respond(conn, 404, "not found\n")
        Err(_) => await respond(conn, 500, "cannot open\n")
    }
}

task fn route(conn: Connection, req: Request) -> Result<(), IoError>
    uses { net.io, fs.read, fs.write }
{
    if has_dotdot(req.path) {
        return await respond(conn, 400, "bad path\n")
    }
    match req.method {
        "PUT" => await upload(conn, req)
        "GET" => await download(conn, req)
        _ => await respond(conn, 405, "method not allowed\n")
    }
}

task fn serve(conn: Connection) -> ()
    uses { net.io, fs.read, fs.write }
{
    match await read_request(&conn) {
        Ok(req) => match await route(conn, req) {
            Ok(_) => ()
            Err(_) => ()
        }
        // The connection was only borrowed, so it is still owned here; the scope closes it.
        Err(_) => ()
    }
}

task fn accept_loop(listener: sink Listener) -> ()
    uses { net.io, fs.read, fs.write }
{
    scope {
        loop {
            match await tcp_accept(&listener) {
                Ok(conn) => spawn serve(conn)
                Err(_) => break
            }
        }
    }
}

task fn main() -> Result<(), IoError>
    uses { clock, net.listen, net.io, fs.read, fs.write }
{
    let listener = await tcp_listen(0)?
    print(to_string(listener_port(&listener)))
    scope {
        spawn accept_loop(listener)
        await sleep(500)
    }
    Ok(())
}

// `..` anywhere in the path, byte for byte: 46 is `.`. Written on the byte primitives —
// `bytes`, `bytes_len`, `data[i]` — because v0 has no substring search.
fn has_dotdot(path: String) -> Bool {
    let data = bytes(path)
    let mut i = 0
    while i + 1 < bytes_len(data) {
        if data[i] == 46 && data[i + 1] == 46 {
            return true
        }
        i = i + 1
    }
    false
}
