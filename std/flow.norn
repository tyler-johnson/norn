// Flow consumption in Norn: `pipe`, the whole of a flow delivered into a file.
//
// The dissolution of `pipe_to`: the demand-driven transfer the runtime did behind one builtin is
// now an ordinary loop over the flow intrinsics. `flow_next` hands over at most one chunk at a
// time — the demand claim, now visible as the one chunk local below — so a large transfer never
// sits in memory, and the per-chunk `pipe` trace lines went with the builtin. The source type
// names the module (`pipe` from `std/flow`, one day `source.pipe(sink)`); the old `_to` suffix
// was doing the sink argument's job.
//
// The open handles are the authority, which is why nothing here reaches for any: `flow_of_file`
// and `file_create` checked `fs.read`/`fs.write` when they opened them, and driving what is
// already open asks for nothing more.

// Deliver everything the flow promises into the sink, then close both ends — completion and
// failure alike consume them, so nothing can legally touch either again and the closes happen
// here rather than at task teardown: `sink` is written on both, the pinned public contract. The
// read-mode split with `transfer` is what makes that eager close reachable on the error path:
// a `?` in this body would return before the closes.
export task fn pipe(flow: sink Flow<Bytes>, sink: sink File) -> Result<I64, IoError> {
    let outcome = await transfer(flow, sink)
    await flow_close(flow)
    await file_close(sink)
    outcome
}

task fn transfer(flow: Flow<Bytes>, sink: File) -> Result<I64, IoError> {
    let mut moved = 0
    loop {
        let chunk = await flow_next(flow)?
        if bytes_len(chunk) == 0 {
            return Ok(moved)
        }
        await file_write(sink, chunk)?
        moved = moved + bytes_len(chunk)
    }
}
