=== nir ===
enum Option #0 (None, Some(?))
enum Result #1 (Ok(?), Err(?))
enum IoError #2 (NotFound, Denied, InUse, Refused, Closed, Other(String))

task fn wait_forever #0() -> ()
    local _0: Task<()>
    local _1: ()
    local _2: ()
  b0:
    _0 = task builtin sleep(1000000)
    await _0 -> _1, resume b1
  b1:
    _2 = builtin print("this line is never reached")
    return _2

task fn main #1() -> ()
    local _0: ()
    local _1: Task<()>
    local _2: Task<()>
    local _3: ()
    local _4: ()
    local _5: ()
  b0:
    scope enter
    _1 = task wait_forever#0()
    spawn _1
    _2 = task builtin sleep(50)
    await _2 -> _3, resume b1
  b1:
    _4 = builtin print("leaving the scope")
    _0 = _4
    scope exit, resume b2
  b2:
    _5 = builtin print("the child was cancelled on the way out")
    return _5

