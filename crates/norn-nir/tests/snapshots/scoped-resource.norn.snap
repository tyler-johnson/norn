  b0:
    _2 = task builtin tcp_listen(0)
    await _2 -> _3, resume b1
  b1:
    switch tag _3 [0 => b2] else b3
  b2:
    _4 = _3.0
    _0/outer = _4
    scope enter
    _7 = task builtin tcp_listen(0)
    await _7 -> _8, resume b4
  b3:
    _5 = #Result.Err(_3.0)
    return _5
  b4:
    switch tag _8 [0 => b5] else b6
  b5:
    _9 = _8.0
    _1/inner = _9
    _11 = builtin listener_port(_0/outer)
    _12 = builtin listener_port(_1/inner)
    _13 = call compare#1(_11, _12)
    _14 = builtin print(_13)
    _15 = task builtin sleep(1)
    await _15 -> _16, resume b8
  b6:
    _10 = #Result.Err(_8.0)
    scope exit, resume b7
  b7:
    return _10
  b8:
    _6 = _16
    scope exit, resume b9
  b9:
    _17 = builtin print("the inner socket is closed and the outer one is not")
    _18 = task builtin sleep(1)
    await _18 -> _19, resume b10
  b10:
    _20 = #Result.Ok(())
    return _20

fn compare #1(_0/a, _1/b)
    local _2
    local _3
  b0:
    _3 = _0/a eq _1/b
    branch _3 ? b1 : b2
  b1:
    _2 = "one socket, twice"
    goto b3
  b2:
    _2 = "two sockets are open"
    goto b3
  b3:
    return _2

