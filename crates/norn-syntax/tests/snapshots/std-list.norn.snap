(module
  (import "std/fmt" (item Display))
  (enum List export
    (type-params T)
    (variant Nil)
    (variant Cons (tuple T (ty List T))))
  (fn length export
    (type-params T)
    (params (param items (ty List T)))
    (ret I64)
    (block
      (match
        (path items)
        (arm (construct List.Nil) (int 0))
        (arm
          (construct List.Cons (arg _) (arg (bind rest)))
          (binary + (int 1) (call (path length) (arg (path rest))))))))
  (fn empty export
    (type-params T)
    (params)
    (ret (ty List T))
    (block (path List.Nil)))
  (fn append export
    (type-params T)
    (params (param items (ty List T)) (param tail (ty List T)))
    (ret (ty List T))
    (block
      (match
        (path items)
        (arm (construct List.Nil) (path tail))
        (arm
          (construct List.Cons (arg (bind head)) (arg (bind rest)))
          (call
            (path List.Cons)
            (arg (path head))
            (arg (call (path append) (arg (path rest)) (arg (path tail)))))))))
  (fn reverse export
    (type-params T)
    (params (param items (ty List T)))
    (ret (ty List T))
    (block (call (path walk) (arg (path items)) (arg (path List.Nil)))))
  (fn walk
    (type-params T)
    (params (param items (ty List T)) (param out (ty List T)))
    (ret (ty List T))
    (block
      (match
        (path items)
        (arm (construct List.Nil) (path out))
        (arm
          (construct List.Cons (arg (bind head)) (arg (bind rest)))
          (call
            (path walk)
            (arg (path rest))
            (arg (call (path List.Cons) (arg (path head)) (arg (path out)))))))))
  (fn take export
    (type-params T)
    (params (param items (ty List T)) (param count I64))
    (ret (ty List T))
    (block
      (if
        (binary <= (path count) (int 0))
        (block (path List.Nil))
        (else
          (block
            (match
              (path items)
              (arm (construct List.Nil) (path List.Nil))
              (arm
                (construct List.Cons (arg (bind head)) (arg (bind rest)))
                (call
                  (path List.Cons)
                  (arg (path head))
                  (arg
                    (call
                      (path take)
                      (arg (path rest))
                      (arg (binary - (path count) (int 1)))))))))))))
  (fn drop export
    (type-params T)
    (params (param items (ty List T)) (param count I64))
    (ret (ty List T))
    (block
      (if
        (binary <= (path count) (int 0))
        (block (path items))
        (else
          (block
            (match
              (path items)
              (arm (construct List.Nil) (path List.Nil))
              (arm
                (construct List.Cons (arg _) (arg (bind rest)))
                (call
                  (path drop)
                  (arg (path rest))
                  (arg (binary - (path count) (int 1)))))))))))
  (fn nth export
    (type-params T)
    (params (param items (ty List T)) (param index I64))
    (ret (ty Option T))
    (block
      (match
        (path items)
        (arm (construct List.Nil) (path None))
        (arm
          (construct List.Cons (arg (bind head)) (arg (bind rest)))
          (if
            (binary == (path index) (int 0))
            (block (call (path Some) (arg (path head))))
            (else
              (block
                (call
                  (path nth)
                  (arg (path rest))
                  (arg (binary - (path index) (int 1)))))))))))
  (fn contains export
    (type-params (bound T Eq))
    (params (param items (ty List T)) (param wanted T))
    (ret Bool)
    (block
      (match
        (path items)
        (arm (construct List.Nil) (bool false))
        (arm
          (construct List.Cons (arg (bind head)) (arg (bind rest)))
          (binary ||
            (binary == (path head) (path wanted))
            (call (path contains) (arg (path rest)) (arg (path wanted))))))))
  (fn join export
    (type-params (bound T Display))
    (params (param items (ty List T)) (param separator String))
    (ret String)
    (block
      (match
        (path items)
        (arm (construct List.Nil) (str ""))
        (arm
          (construct List.Cons (arg (bind head)) (arg (bind rest)))
          (match
            (path rest)
            (arm (construct List.Nil) (call (path head.to_string)))
