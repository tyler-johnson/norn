(module
  (struct Snapshot (field open I64) (field healthy Bool))
  (reactor Gate export
    (params (param limit I64))
    (input opened unit (queue (int 64) reject))
    (input closed unit (queue (int 8) drop_oldest))
    (input measured Sample (queue (int 1) drop_newest))
    (input queued Job (queue (int 128) wait))
    (state accepted I64 (int 0))
    (state released I64 (int 0))
    (on opened
      (params)
      (block (assign (path accepted) (binary + (path accepted) (int 1)))))
    (on closed
      (params)
      (block (assign (path released) (binary - (path released) (int 1)))))
    (signal open (binary - (path accepted) (path released)))
    (signal healthy (ty Bool) (binary <= (path open) (path limit)))
    (signal snapshot export
      (call (path Snapshot) (arg open (path open)) (arg healthy (path healthy)))))
  (reactor Mailbox
    (params (param retries I64))
    (uses clock net.io)
    (input send OutgoingMessage (queue (int 256) wait))
    (input delivered DeliveryResult (queue (int 256) wait))
    (state pending I64 (int 0))
    (state failed I64 (int 0))
    (on send
      (params message)
      (block
        (assign (path pending) (binary + (path pending) (int 1)))
        (after (call (path deliver) (arg (path message))) (returns delivered))))
    (on delivered
      (params result)
      (block
        (assign (path pending) (binary - (path pending) (int 1)))
        (match
          (path result)
          (arm (construct DeliveryResult.Ok) unit)
          (arm
            (construct DeliveryResult.Failed (arg _))
            (block (assign (path failed) (binary + (path failed) (int 1))))))))
    (signal depth export (path pending))
    (signal report export
      (call
        (path Report)
        (arg pending (path pending))
        (arg failed (path failed))
        (arg retries (path retries)))))
  (reactor Meter
    (params (param window I64))
    (on sampled
      (params (param value F64))
      (queue (int 32) drop_oldest)
      (block
        (assign (path total) (binary + (path total) (path value)))
        (assign (path seen) (binary + (path seen) (int 1)))))
    (on reset
      (params)
      (queue (int 1) reject)
      (block (assign (path total) (float 0.0)) (assign (path seen) (int 0))))
    (input trimmed Trim (queue (int 4) wait))
    (state total F64 (float 0.0))
    (state seen I64 (int 0))
    (on trimmed
      (params bound)
      (block (assign (path seen) (binary - (path seen) (path bound.count)))))
    (signal mean export (binary / (path total) (path window))))
  (fn drive task
    (params (param limit I64))
    (ret unit)
    (block
      (let gate (spawn-reactor Gate (arg limit (path limit))))
      (await (call (path send) (arg (path gate.opened)) (arg unit)))
      (call (path print) (arg (call (path latest) (arg (path gate.snapshot))))))))

=== canonical ===
struct Snapshot {
    open: I64
    healthy: Bool
}

export reactor Gate(limit: I64) {
    input opened: () [capacity: 64, overflow: reject]
    input closed: () [capacity: 8, overflow: drop_oldest]
    input measured: Sample [capacity: 1, overflow: drop_newest]
    input queued: Job [capacity: 128, overflow: wait]
    state accepted: I64 = 0
    state released: I64 = 0
    on opened() {
        accepted = accepted + 1
    }
    on closed() {
        released = released - 1
    }
    signal open = accepted - released
    signal healthy: Bool = open <= limit
    export signal snapshot = Snapshot(open: open, healthy: healthy)
}

reactor Mailbox(retries: I64)
    uses { clock, net.io }
{
    input send: OutgoingMessage [capacity: 256, overflow: wait]
    input delivered: DeliveryResult [capacity: 256, overflow: wait]
    state pending: I64 = 0
    state failed: I64 = 0
    on send(message) {
        pending = pending + 1
        after deliver(message) -> delivered
    }
    on delivered(result) {
        pending = pending - 1
        match result {
            DeliveryResult.Ok => ()
            DeliveryResult.Failed(_) => {
                failed = failed + 1
            }
        }
    }
    export signal depth = pending
    export signal report = Report(pending: pending, failed: failed, retries: retries)
}

reactor Meter(window: I64) {
    on sampled(value: F64) [capacity: 32, overflow: drop_oldest] {
        total = total + value
        seen = seen + 1
    }
    on reset() [capacity: 1, overflow: reject] {
        total = 0.0
        seen = 0
    }
    input trimmed: Trim [capacity: 4, overflow: wait]
    state total: F64 = 0.0
    state seen: I64 = 0
    on trimmed(bound) {
        seen = seen - bound.count
    }
    export signal mean = total / window
}

task fn drive(limit: I64) -> () {
    let gate = spawn reactor Gate(limit: limit)
    await send(gate.opened, ())
    print(latest(gate.snapshot))
}
