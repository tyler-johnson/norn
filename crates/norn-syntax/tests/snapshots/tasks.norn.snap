          (await
            (call
              (path response.json)
              (type-args Profile)
              (arg limit (field (int 2) mebibytes))))))))
  (fn load_config task
    (params (param path Path))
    (ret (ty Result Config LoadError))
    (uses fs.read)
    (block
      (let config
        (try
          (await (call (path fs.read_json) (type-args Config) (arg (path path))))))
      (return (construct Ok (arg (path config))))))
  (fn greet task
    (params (param path Path) (param id UserId))
    (ret (ty Result String))
    (uses fs.read net.connect clock)
    (block
      (let config (try (await (call (path load_config) (arg (path path))))))
      (let profile
        (try
          (await
            (call (path fetch_profile) (arg (path config.upstream)) (arg (path id))))))
      (return
        (construct Ok
          (arg
            (binary +
              (binary + (path config.greeting) (str ", "))
              (path profile.display_name)))))))
  (fn pipeline
    (params (param samples (ty Event Float)) (param count USize))
    (ret (ty Signal Float))
    (block
      (return
        (call
          (field
            (call
              (field (call (path samples.window) (arg (path count))) map)
              (arg
                (lambda
                  (params (bind values))
                  (call (path mean) (arg (path values))))))
            hold)
          (arg (float 0.0))))))
  (fn policies
    (params (param files (ty Event Path)) (param changes (ty Event Path)))
