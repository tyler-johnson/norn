        (arm (int 204) (str "No Content"))
        (arm (int 400) (str "Bad Request"))
        (arm (int 404) (str "Not Found"))
        (arm (int 405) (str "Method Not Allowed"))
        (arm (int 500) (str "Internal Server Error"))
        (arm _ (str ""))))))

=== canonical ===
import { to_string, to_int } from "std/fmt"
import { List } from "std/list"

export struct Header {
    name: String
    value: String
}

export struct Request {
    method: String
    path: String
    headers: List<Header>
    content_length: I64
    leftover: Bytes
}

export enum HeadParse {
    Incomplete
    Complete(Request, I64)
    Invalid(String)
}

export fn head(data: Bytes) -> HeadParse {
    let len = bytes_len(data)
    match terminator(data, len) {
        None => {
            if len >= 8192 {
                return HeadParse.Invalid("the request head exceeds 8192 bytes")
            }
            HeadParse.Incomplete
        }
        Some(end) => {
            if end > 8192 {
                return HeadParse.Invalid("the request head exceeds 8192 bytes")
            }
            parse(data, end)
        }
    }
}

export fn header(req: Request, name: String) -> Option<String> {
    let wanted = bytes(name)
    lookup(req.headers, lower(wanted, 0, bytes_len(wanted)))
}

export fn response_head(status: I64, content_length: I64) -> String {
    "HTTP/1.1 " + to_string(status) + " " + reason(status) + "\r\nContent-Length: " + to_string(content_length) + "\r\nConnection: close\r\n\r\n"
}

export task fn read_request(conn: &Connection) -> Result<Request, IoError>
    uses { net.io }
{
    let mut gathered = bytes("")
    loop {
        match head(gathered) {
            HeadParse.Complete(req, consumed) => {
                let len = bytes_len(gathered)
                let mut stop = consumed + req.content_length
                if stop > len {
                    stop = len
                }
                return Ok(Request(method: req.method, path: req.path, headers: req.headers, content_length: req.content_length, leftover: bytes_slice(gathered, consumed, stop)))
            }
            HeadParse.Invalid(rule) => {
                return Err(IoError.Other(rule))
            }
            HeadParse.Incomplete => {
                gathered = bytes_concat(gathered, await tcp_read(conn)?)
            }
        }
    }
}

export task fn respond(conn: Connection, status: I64, body: String) -> Result<(), IoError>
    uses { net.io }
{
    let payload = bytes(body)
    let outcome = await tcp_write(&conn, bytes_concat(bytes(response_head(status, bytes_len(payload))), payload))
    await tcp_close(conn)
    outcome
}

export task fn respond_empty(conn: Connection, status: I64) -> Result<(), IoError>
    uses { net.io }
{
    await respond(conn, status, "")
}

export task fn respond_flow(conn: Connection, status: I64, body: Flow<Bytes>) -> Result<(), IoError>
    uses { net.io }
{
    let outcome = await stream(&conn, &body, status)
    await flow_close(body)
    await tcp_close(conn)
    outcome
}

task fn stream(conn: &Connection, body: &Flow<Bytes>, status: I64) -> Result<(), IoError>
    uses { net.io }
{
    await tcp_write(conn, bytes(response_head(status, flow_len(body))))?
    loop {
        let chunk = await flow_next(body)?
        if bytes_len(chunk) == 0 {
            return Ok(())
        }
        await tcp_write(conn, chunk)?
    }
}

export task fn save_body(conn: &Connection, req: Request, sink: File) -> Result<I64, IoError>
    uses { net.io }
{
    let outcome = await receive(conn, &sink, req)
    await file_close(sink)
    outcome
}

task fn receive(conn: &Connection, sink: &File, req: Request) -> Result<I64, IoError>
    uses { net.io }
{
    await file_write(sink, req.leftover)?
    let mut written = bytes_len(req.leftover)
    while written < req.content_length {
        let chunk = await tcp_read(conn)?
        let due = req.content_length - written
        let mut take = bytes_len(chunk)
        if take > due {
            take = due
        }
        await file_write(sink, bytes_slice(chunk, 0, take))?
        written = written + take
    }
    Ok(written)
}

fn parse(data: Bytes, end: I64) -> HeadParse {
    let stop = end - 4
    let mut i = 0
    while i < stop {
        if data[i] > 127 {
            return HeadParse.Invalid("the request head is not ASCII text")
        }
        i = i + 1
    }
    let line_end = line_break(data, 0, stop)
    if count_at(data, 32, 0, line_end) != 2 {
        return HeadParse.Invalid("the request line is not `METHOD PATH HTTP/1.1`")
    }
    let sp1 = find_at(data, 32, 0, line_end)
    let sp2 = find_at(data, 32, sp1 + 1, line_end)
    if sp1 == 0 || !uppercase(data, 0, sp1) {
        return HeadParse.Invalid("the method is not an upper-case token")
    }
    if sp2 == sp1 + 1 {
        return HeadParse.Invalid("the request path is empty")
    }
    if bytes_slice(data, sp2 + 1, line_end) != bytes("HTTP/1.1") {
        return HeadParse.Invalid("only HTTP/1.1 is spoken here")
    }
    let mut headers: List<Header> = List.Nil
    let mut cursor = line_end
    while cursor < stop {
        cursor = cursor + 2
        let brk = line_break(data, cursor, stop)
        match header_line(data, cursor, brk) {
            Ok(h) => {
                headers = List.Cons(h, headers)
            }
            Err(rule) => {
                return HeadParse.Invalid(rule)
            }
        }
        cursor = brk
    }
    if named(headers, "transfer-encoding") > 0 {
        return HeadParse.Invalid("Transfer-Encoding is not supported; bodies are Content-Length")
    }
    let lengths = named(headers, "content-length")
    if lengths > 1 {
        return HeadParse.Invalid("Content-Length appears twice")
    }
    let mut content_length = 0
    if lengths == 1 {
        match lookup(headers, "content-length") {
            Some(value) => match to_int(value) {
                Some(n) => {
                    if n < 0 {
                        return HeadParse.Invalid("Content-Length is not a number")
                    }
                    content_length = n
                }
                None => {
                    return HeadParse.Invalid("Content-Length is not a number")
                }
            }
            None => ()
        }
    }
    let req = Request(method: text_unchecked(bytes_slice(data, 0, sp1)), path: text_unchecked(bytes_slice(data, sp1 + 1, sp2)), headers: headers, content_length: content_length, leftover: bytes(""))
    HeadParse.Complete(req, end)
}

fn header_line(data: Bytes, from: I64, stop: I64) -> Result<Header, String> {
    let colon = find_at(data, 58, from, stop)
    if colon == stop {
        return Err("a header line has no `:`")
    }
    if colon == from || find_at(data, 32, from, colon) != colon || find_at(data, 9, from, colon) != colon {
        return Err("a header name is not a token")
    }
    let mut lo = colon + 1
    let mut hi = stop
    while lo < hi && whitespace(data[lo]) {
        lo = lo + 1
    }
    while hi > lo && whitespace(data[hi - 1]) {
        hi = hi - 1
    }
    Ok(Header(name: lower(data, from, colon), value: text_unchecked(bytes_slice(data, lo, hi))))
}

fn terminator(data: Bytes, len: I64) -> Option<I64> {
    let mut i = 0
    while i + 3 < len {
        if data[i] == 13 && data[i + 1] == 10 && data[i + 2] == 13 && data[i + 3] == 10 {
            return Some(i + 4)
        }
        i = i + 1
    }
    None
}

fn line_break(data: Bytes, from: I64, stop: I64) -> I64 {
    let mut i = from
    while i + 1 < stop {
        if data[i] == 13 && data[i + 1] == 10 {
            return i
        }
        i = i + 1
    }
    stop
}

fn find_at(data: Bytes, wanted: I64, from: I64, stop: I64) -> I64 {
    let mut i = from
    while i < stop {
        if data[i] == wanted {
            return i
        }
        i = i + 1
    }
    stop
}

fn count_at(data: Bytes, wanted: I64, from: I64, stop: I64) -> I64 {
    let mut n = 0
    let mut i = from
    while i < stop {
        if data[i] == wanted {
            n = n + 1
        }
        i = i + 1
    }
    n
}

fn uppercase(data: Bytes, from: I64, stop: I64) -> Bool {
    let mut i = from
    while i < stop {
        if data[i] < 65 || data[i] > 90 {
            return false
        }
        i = i + 1
    }
    true
}

fn whitespace(b: I64) -> Bool {
    b == 32 || b >= 9 && b <= 13
}

fn lower(data: Bytes, from: I64, stop: I64) -> String {
    let mut out = bytes("")
    let mut i = from
    while i < stop {
        let mut b = data[i]
        if b >= 65 && b <= 90 {
            b = b + 32
        }
        out = bytes_concat(out, byte(b))
        i = i + 1
    }
    text_unchecked(out)
}

fn named(headers: List<Header>, name: String) -> I64 {
    match headers {
        List.Nil => 0
        List.Cons(h, rest) => {
            if h.name == name {
                1 + named(rest, name)
            } else {
                named(rest, name)
            }
        }
    }
}

fn lookup(headers: List<Header>, name: String) -> Option<String> {
    match headers {
        List.Nil => None
        List.Cons(h, rest) => {
            if h.name == name {
                Some(h.value)
            } else {
                lookup(rest, name)
            }
        }
    }
}

fn reason(status: I64) -> String {
    match status {
        200 => "OK"
        201 => "Created"
        204 => "No Content"
        400 => "Bad Request"
        404 => "Not Found"
        405 => "Method Not Allowed"
        500 => "Internal Server Error"
        _ => ""
    }
}
