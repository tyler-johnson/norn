(module
  (import "std/fmt" (item to_string) (item to_int))
  (import "std/list" (item List))
  (struct Header export (field name String) (field value String))
  (struct Request export
    (field method String)
    (field path String)
    (field headers (ty List Header))
    (field content_length I64)
    (field leftover Bytes))
  (enum HeadParse export
    (variant Incomplete)
    (variant Complete (tuple Request I64))
    (variant Invalid (tuple String)))
  (fn head export
    (params (param data Bytes))
    (ret HeadParse)
    (block
      (let len (call (path bytes_len) (arg (path data))))
      (match
        (call (path terminator) (arg (path data)) (arg (path len)))
        (arm
          (bind None)
          (block
            (if
              (binary >= (path len) (int 8192))
              (block
                (return
                  (call
                    (path HeadParse.Invalid)
                    (arg (str "the request head exceeds 8192 bytes"))))))
            (path HeadParse.Incomplete)))
        (arm
          (construct Some (arg (bind end)))
          (block
            (if
              (binary > (path end) (int 8192))
              (block
                (return
                  (call
                    (path HeadParse.Invalid)
                    (arg (str "the request head exceeds 8192 bytes"))))))
            (call (path parse) (arg (path data)) (arg (path end))))))))
