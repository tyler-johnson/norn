(module
  (struct User export (field id I64) (field name String) (field email String))
  (struct Profile
    (field user User)
    (field display_name String)
    (field verified Bool))
  (enum LoadError export
    (variant NotFound)
    (variant Invalid (tuple String))
    (variant Io (fields (field code I64) (field message String))))
  (fn display_name export
    (params (param profile (ref Profile)))
    (ret String)
    (block (return (path profile.display_name))))
  (fn describe
    (params (param error LoadError))
    (ret String)
    (block
      (match
        (path error)
        (arm (construct LoadError.NotFound) (str "not found"))
        (arm (construct LoadError.Invalid (arg (bind reason))) (path reason))
        (arm
          (construct LoadError.Io (arg code (int 404)) (arg message (bind message)))
          (path message))
        (arm (construct LoadError.Io ..) (str "io error")))))
  (fn severity
    (params (param error LoadError))
    (ret I64)
    (block
      (match
        (path error)
        (arm
          (or (construct LoadError.NotFound) (construct LoadError.Invalid (arg _)))
          (int 1))
        (arm (bind other) (int 2)))))
  (fn classify
    (params (param user User))
    (ret String)
    (block
      (if
        (binary == (path user.id) (int 0))
        (block (return (str "root")))
        (else
          (if
            (binary < (path user.id) (int 1000))
            (block (return (str "system")))
            (else (block (return (str "ordinary")))))))))
  (fn arithmetic
    (params (param a I64) (param b I64))
    (ret I64)
    (block
      (let sum (binary - (binary + (path a) (binary * (path b) (int 2))) (int 1)))
      (let scaled (binary * (binary + (path a) (path b)) (int 3)))
      (let mixed
        (binary ||
          (binary &&
            (binary < (path a) (path b))
            (binary > (path sum) (path scaled)))
          (unary ! (bool true))))
      (return (binary + (path sum) (path scaled)))))
  (fn build
    (params (param name String))
    (ret Profile)
    (block
      (let user
        (call
          (path User)
          (arg id (int 7))
          (arg name (path name))
          (arg email (str "nobody@example.com"))))
      (return
        (call
          (path Profile)
          (arg user (path user))
          (arg display_name (str "seven"))
          (arg verified (bool false)))))))

=== canonical ===
export struct User {
    id: I64
    name: String
    email: String
}

struct Profile {
    user: User
    display_name: String
    verified: Bool
}

export enum LoadError {
    NotFound
    Invalid(String)
    Io { code: I64, message: String }
}

export fn display_name(profile: &Profile) -> String {
    return profile.display_name
}

fn describe(error: LoadError) -> String {
    match error {
        LoadError.NotFound => "not found"
        LoadError.Invalid(reason) => reason
        LoadError.Io(code: 404, message: message) => message
        LoadError.Io(..) => "io error"
    }
}

fn severity(error: LoadError) -> I64 {
    match error {
        LoadError.NotFound | LoadError.Invalid(_) => 1
        other => 2
    }
}

fn classify(user: User) -> String {
    if user.id == 0 {
        return "root"
    } else if user.id < 1000 {
        return "system"
    } else {
        return "ordinary"
    }
}

fn arithmetic(a: I64, b: I64) -> I64 {
    let sum = a + b * 2 - 1
    let scaled = (a + b) * 3
    let mixed = a < b && sum > scaled || !true
    return sum + scaled
}

fn build(name: String) -> Profile {
    let user = User(id: 7, name: name, email: "nobody@example.com")
    return Profile(user: user, display_name: "seven", verified: false)
}
